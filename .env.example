# Environment Variables for Telegram Multi-Instance Manager

# A strong random secret token — used by the front-end login and Public API Bearer auth
ACCESS_TOKEN=change_me_to_a_strong_secret

# Server port
PORT=3000

# Public URL of this instance (used to generate absolute links for webhooks, e.g. media downloads)
PUBLIC_URL=http://localhost:3000

# PostgreSQL database URL (used locally, Docker Compose overwrites this for the container)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/telegram_multi_instance_manager?schema=public"

# Telegram API credentials — get them at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

API_LOGS_RETENTION_DAYS=30
WEBHOOK_LOGS_RETENTION_DAYS=30

# ── Cache & Webhook Resilience Configuration ───────────────────────────────
# Driver de Cache: 'memory' (padrão, RAM local com TTL) ou 'redis'
CACHE_DRIVER=memory
# URL do Redis (usado quando CACHE_DRIVER=redis). Ex: redis://:senha@host:6379
# REDIS_URL=redis://localhost:6379

# Retentativas e Resiliência de Webhooks
# Número máximo de tentativas por webhook (padrão: 3)
WEBHOOK_MAX_RETRIES=3
# Timeout máximo por requisição HTTP em milissegundos (padrão: 15000 = 15s)
WEBHOOK_TIMEOUT_MS=15000
# Delay base inicial do Backoff Exponencial em milissegundos (padrão: 2000 = 2s, depois 4s, 8s...)
WEBHOOK_RETRY_DELAY_MS=2000

